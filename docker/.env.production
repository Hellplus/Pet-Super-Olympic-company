# ==============================
# IPOC 生产环境配置
# 部署前请修改以下配置项！
# ==============================

# 服务端口（外部访问端口）
APP_PORT=80

# 数据库配置
DB_DATABASE=ipoc_admin
DB_USERNAME=ipoc
DB_PASSWORD=Change_Me_To_A_Strong_Password_123!

# Redis配置
REDIS_PASSWORD=Change_Me_To_A_Strong_Redis_Password_456!

# JWT密钥（务必修改为随机长字符串）
JWT_SECRET=Change_Me_To_A_Random_64_Char_String_For_Production_Security!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
